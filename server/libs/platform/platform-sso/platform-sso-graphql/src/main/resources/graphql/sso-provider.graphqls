extend type Query {
    "Admin only. One SSO provider by id."
    ssoProvider(id: ID!): SsoProvider
    "Admin only. All SSO providers, ordered by name."
    ssoProviders: [SsoProvider!]!
}

extend type Mutation {
    "Admin only. Creates an SSO provider; the registration id is generated by the server."
    createSsoProvider(input: SsoProviderInput!): SsoProvider!
    "Admin only."
    deleteSsoProvider(id: ID!): Boolean!
    "Admin only. The type cannot change; omit clientSecret (or send null/empty) to keep the stored one."
    updateSsoProvider(id: ID!, input: SsoProviderInput!): SsoProvider!
}

enum SsoProviderType {
    OIDC
    SAML
}

"The identity-provider product behind an OIDC provider; selects vendor-specific validation. SAML is always GENERIC."
enum SsoProviderVendor {
    GENERIC
    "Microsoft Entra ID, single tenant: issuerUri must be https://login.microsoftonline.com/<tenant GUID>/v2.0."
    MICROSOFT_ENTRA_ID
}

type SsoProvider {
    id: ID!
    name: String!
    type: SsoProviderType!
    vendor: SsoProviderVendor!
    enabled: Boolean!
    "Lower-cased email domains served by this provider."
    domains: [String!]!
    "When true, password login is refused for users on these domains (local admins excepted)."
    enforceSso: Boolean!
    autoProvision: Boolean!
    "Authority given to auto-provisioned users: ROLE_USER or ROLE_ADMIN."
    defaultAuthority: String!
    "Opaque id used in the login URLs."
    registrationId: String!
    "Server-relative URL that starts a login through this provider."
    loginPath: String!
    "Server-relative callback to register at the IdP: the OIDC redirect URI or the SAML assertion consumer service."
    callbackPath: String!
    "SAML only: server-relative URL of the service provider metadata; its absolute form is the SP entity id."
    serviceProviderMetadataPath: String
    issuerUri: String
    clientId: String
    "Whether an OIDC client secret is stored. The secret itself is write-only and never returned."
    clientSecretSet: Boolean!
    scopes: [String!]!
    metadataUrl: String
    metadataXml: String
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
}

input SsoProviderInput {
    name: String!
    "Required on create, ignored on update."
    type: SsoProviderType
    "OIDC only; defaults to GENERIC."
    vendor: SsoProviderVendor
    enabled: Boolean!
    domains: [String!]
    enforceSso: Boolean
    autoProvision: Boolean
    defaultAuthority: String
    issuerUri: String
    clientId: String
    "Write-only."
    clientSecret: String
    scopes: [String!]
    metadataUrl: String
    metadataXml: String
}
